   "statements": [
    {
     "sql": "SELECT event_id, aggregate_id, aggregate_version, event_type, schema_version,\n       IF(published_at IS NULL, 'pending', 'published') AS state\nFROM outbox ORDER BY event_id",
     "status": "ok",
     "columns": [
