     "sql": "CREATE TABLE processed_events (\n  consumer     VARCHAR(30) NOT NULL,\n  event_id     BIGINT UNSIGNED NOT NULL,\n  processed_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  PRIMARY KEY (consumer, event_id)\n)",
     "status": "ok",
     "columns": [],
     "affected_rows": 0,
     "rows": []
    },
    {
     "sql": "CREATE TABLE loyalty_points (customer_id INT UNSIGNED PRIMARY KEY, points INT NOT NULL)",
     "status": "ok",
     "columns": [],
     "affected_rows": 0,
     "rows": []
    },
    {
     "sql": "CREATE PROCEDURE loyalty_on_order_placed(IN p_event_id BIGINT UNSIGNED)\nBEGIN\n  DECLARE v_customer INT UNSIGNED;\n  DECLARE v_total DECIMAL(10,2);\n  START TRANSACTION;\n  INSERT IGNORE INTO processed_events (consumer, event_id) VALUES ('loyalty', p_event_id);\n  IF ROW_COUNT() = 1 THEN\n    SELECT payload->>'$.customer_id', payload->>'$.total' INTO v_customer, v_total\n    FROM outbox WHERE event_id = p_event_id AND event_type = 'OrderPlaced';\n    INSERT INTO loyalty_points (customer_id, points) VALUES (v_customer, FLOOR(v_total)) AS new\n    ON DUPLICATE KEY UPDATE points = loyalty_points.points + new.points;\n  END IF;\n  COMMIT;\nEND",
     "status": "ok",
     "columns": [],
     "affected_rows": 0,
     "rows": []
    },
    {
     "sql": "CALL loyalty_on_order_placed(1)",
     "status": "ok",
     "columns": [],
     "affected_rows": 0,
     "rows": []
    },
    {
     "sql": "CALL loyalty_on_order_placed(1)",
     "status": "ok",
     "columns": [],
     "affected_rows": 0,
     "rows": []
    },
    {
     "sql": "CALL loyalty_on_order_placed(1)",
     "status": "ok",
     "columns": [],
     "affected_rows": 0,
     "rows": []
    },
