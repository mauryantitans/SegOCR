     "sql": "CREATE PROCEDURE small_updates(IN n INT)\nBEGIN\n  DECLARE i INT DEFAULT 0;\n  WHILE i < n DO\n    UPDATE ledger SET amount = amount + 1 WHERE id = 1 + (i * 37) % 200000;\n    SET i = i + 1;\n  END WHILE;\nEND",
