  "s14:6cdb47589825": {
   "statements": [
    {
     "sql": "CREATE TRIGGER trg_student_ta_one_per_course\nBEFORE INSERT ON student_ta\nFOR EACH ROW\nBEGIN\n  IF EXISTS (SELECT 1\n             FROM student_ta st\n             JOIN ta_course tc_old ON tc_old.ta_name = st.ta_name\n             JOIN ta_course tc_new ON tc_new.ta_name = NEW.ta_name\n             WHERE st.student_id = NEW.student_id\n               AND tc_old.course_id = tc_new.course_id) THEN\n    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'student already has a TA for this course';\n  END IF;\nEND",
     "status": "ok",
     "columns": [],
     "affected_rows": 0,
     "rows": []
    }
   ],
   "measured": null
  },
