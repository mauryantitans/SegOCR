  "s7:0ee231ae34a2": {
   "statements": [
    {
     "sql": "EXPLAIN FORMAT=TREE\nSELECT c.city, COUNT(*) AS orders\nFROM customers c\nJOIN orders o ON o.customer_id = c.customer_id\nWHERE o.status = 'delivered'\nGROUP BY c.city",
     "status": "ok",
     "columns": [
      "EXPLAIN"
     ],
     "row_count": 1,
     "rows": [
      [
       "-> Table scan on <temporary>\n    -> Aggregate using temporary table\n        -> Nested loop inner join  (cost=12.9 rows=13.3)\n            -> Filter: (o.`status` = 'delivered')  (cost=8.25 rows=13.3)\n                -> Table scan on o  (cost=8.25 rows=80)\n            -> Single-row index lookup on c using PRIMARY (customer_id=o.customer_id)  (cost=0.257 rows=1)\n"
      ]
     ]
    }
   ],
   "measured": null
  },
