  "s6:de7a7ce231a8": {
   "statements": [
    {
     "sql": "CREATE PROCEDURE price_band(IN p_product INT)\nBEGIN\n  DECLARE v_price DECIMAL(10,2);\n  DECLARE v_band  VARCHAR(10) DEFAULT 'unknown';\n  SELECT price INTO v_price FROM products WHERE product_id = p_product;\n  SET v_band = CASE WHEN v_price >= 500 THEN 'premium'\n                    WHEN v_price >= 100 THEN 'mid'\n                    ELSE 'budget' END;\n  SELECT p_product AS product_id, v_price AS price, v_band AS band;\nEND",
     "status": "ok",
     "columns": [],
     "affected_rows": 0,
     "rows": []
    },
    {
     "sql": "CALL price_band(1)",
     "status": "ok",
     "columns": [
      "product_id",
      "price",
      "band"
     ],
     "row_count": 1,
     "affected_rows": 0,
     "rows": [
      [
       1,
       "1299.00",
       "premium"
      ]
     ]
    }
   ],
   "measured": null
