     "sql": "CREATE PROCEDURE count_all_tables()\n  READS SQL DATA\nBEGIN\n  DECLARE v_table VARCHAR(64);\n  DECLARE done BOOLEAN DEFAULT FALSE;\n  DECLARE cur CURSOR FOR\n    SELECT TABLE_NAME FROM information_schema.TABLES\n    WHERE TABLE_SCHEMA = DATABASE() AND TABLE_TYPE = 'BASE TABLE'\n    ORDER BY TABLE_NAME;\n  DECLARE CONTINUE HANDLER FOR NOT FOUND SET done = TRUE;\n  CREATE TEMPORARY TABLE IF NOT EXISTS table_counts (table_name VARCHAR(64) PRIMARY KEY, row_count BIGINT);\n  DELETE FROM table_counts;\n  OPEN cur;\n  l: LOOP\n    FETCH cur INTO v_table;\n    IF done THEN\n      LEAVE l;\n    END IF;\n    SET @q = CONCAT('INSERT INTO table_counts SELECT ', QUOTE(v_table), ', COUNT(*) FROM `',\n                    REPLACE(v_table, '`', '``'), '`');\n    PREPARE q FROM @q;\n    EXECUTE q;\n    DEALLOCATE PREPARE q;\n  END LOOP;\n  CLOSE cur;\nEND",
     "status": "ok",
     "columns": [],
     "affected_rows": 0,
     "rows": []
    },
    {
     "sql": "CALL count_all_tables()",
     "status": "ok",
     "columns": [],
     "affected_rows": 0,
     "rows": []
