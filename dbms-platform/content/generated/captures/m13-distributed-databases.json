  "s10:dbc50b48de00": {
   "statements": [
    {
     "sql": "WITH RECURSIVE n(v) AS (SELECT 3 UNION ALL SELECT v + 2 FROM n WHERE v < 5),\n     k(v) AS (SELECT 1 UNION ALL SELECT v + 1 FROM k WHERE v < 5)\nSELECT n.v AS N, w.v AS W, r.v AS R,\n       (r.v + w.v > n.v)      AS reads_see_latest_write,\n       (w.v > n.v / 2)        AS no_conflicting_write_quorums,\n       n.v - w.v              AS failures_tolerated_for_writes,\n       n.v - r.v              AS failures_tolerated_for_reads\nFROM n JOIN k w ON w.v <= n.v JOIN k r ON r.v <= n.v\nWHERE (n.v, w.v, r.v) IN ((3,2,2), (3,3,1), (3,1,3), (3,1,1), (5,3,3), (5,4,2))\nORDER BY N, W, R",
     "status": "ok",
     "columns": [
      "N",
      "W",
      "R",
      "reads_see_latest_write",
      "no_conflicting_write_quorums",
      "failures_tolerated_for_writes",
      "failures_tolerated_for_reads"
     ],
