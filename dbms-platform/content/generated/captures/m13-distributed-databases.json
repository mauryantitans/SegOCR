  "s9:7c66468fe5f1": {
   "statements": [
    {
     "sql": "CREATE TABLE bucket_map (bucket SMALLINT UNSIGNED PRIMARY KEY, shard TINYINT UNSIGNED NOT NULL)",
     "status": "ok",
     "columns": [],
     "affected_rows": 0,
     "rows": []
    },
    {
     "sql": "INSERT INTO bucket_map\nWITH RECURSIVE b(n) AS (SELECT 0 UNION ALL SELECT n + 1 FROM b WHERE n < 1023)\nSELECT n, n % 4 FROM b",
     "status": "ok",
     "columns": [],
     "affected_rows": 1024,
     "info": "Records: 1024  Duplicates: 0  Warnings: 0",
     "rows": []
    },
    {
     "sql": "-- add shard 4: move every 5th bucket to it (about 1/5 of the buckets)\nCREATE TABLE bucket_map_v2 AS SELECT bucket, IF(bucket % 5 = 0, 4, shard) AS shard FROM bucket_map",
     "status": "ok",
     "columns": [],
     "affected_rows": 1024,
     "info": "Records: 1024  Duplicates: 0  Warnings: 0",
     "rows": []
    },
    {
     "sql": "WITH RECURSIVE ids(id) AS (SELECT 1 UNION ALL SELECT id + 1 FROM ids WHERE id < 10000)\nSELECT ROUND(100 * AVG(m1.shard <> m2.shard), 1) AS pct_keys_moved_with_buckets,\n       COUNT(DISTINCT m2.shard) AS shards_after\nFROM ids\nJOIN bucket_map    m1 ON m1.bucket = CRC32(ids.id) % 1024\nJOIN bucket_map_v2 m2 ON m2.bucket = CRC32(ids.id) % 1024",
     "status": "ok",
     "columns": [
      "pct_keys_moved_with_buckets",
      "shards_after"
     ],
     "row_count": 1,
     "rows": [
      [
       "20.2",
       5
      ]
     ]
    },
    {
     "sql": "SELECT shard, COUNT(*) AS buckets FROM bucket_map_v2 GROUP BY shard ORDER BY shard",
     "status": "ok",
     "columns": [
      "shard",
      "buckets"
     ],
     "row_count": 5,
     "rows": [
      [
       0,
       204
      ],
