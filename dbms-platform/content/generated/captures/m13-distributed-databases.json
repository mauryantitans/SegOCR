  "s8:57ed6d7ebb66": {
   "statements": [
    {
     "sql": "SET SESSION cte_max_recursion_depth = 10000",
     "status": "ok",
     "columns": [],
     "affected_rows": 0,
     "rows": []
    },
    {
     "sql": "WITH RECURSIVE ids(id) AS (SELECT 1 UNION ALL SELECT id + 1 FROM ids WHERE id < 10000)\nSELECT COUNT(*) AS keys_total,\n       SUM(CRC32(id) % 4 <> CRC32(id) % 5) AS keys_moved_mod,\n       ROUND(100 * AVG(CRC32(id) % 4 <> CRC32(id) % 5), 1) AS pct_moved_mod\nFROM ids",
     "status": "ok",
     "columns": [
      "keys_total",
      "keys_moved_mod",
      "pct_moved_mod"
     ],
     "row_count": 1,
     "rows": [
