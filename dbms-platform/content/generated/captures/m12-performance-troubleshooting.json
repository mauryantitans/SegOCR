  "s9:4eb188e9944d": {
   "statements": [
    {
     "sql": "CREATE TABLE query_log (id INT AUTO_INCREMENT PRIMARY KEY, digest VARCHAR(80) NOT NULL, duration_ms DECIMAL(10,3) NOT NULL, rows_examined INT NOT NULL)",
     "status": "ok",
     "columns": [],
     "affected_rows": 0,
     "rows": []
    },
    {
     "sql": "INSERT INTO query_log (digest, duration_ms, rows_examined)\nWITH RECURSIVE s(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM s WHERE n < 3000)\nSELECT CASE WHEN n % 100 = 0 THEN 'SELECT … FROM orders WHERE created_at BETWEEN ? AND ? (report)'\n            WHEN n % 3 = 0  THEN 'SELECT … FROM orders WHERE customer_id = ? ORDER BY created_at DESC LIMIT ?'\n            WHEN n % 3 = 1  THEN 'SELECT … FROM products WHERE product_id = ?'\n            ELSE                 'UPDATE carts SET … WHERE cart_id = ?' END,\n       CASE WHEN n % 100 = 0 THEN 1800 + (n % 7) * 100\n            WHEN n % 3 = 0  THEN 60 + (n % 11) * 4 + IF(n % 37 = 0, 400, 0)\n            WHEN n % 3 = 1  THEN 0.300 + (n % 5) * 0.05\n            ELSE                 1.2 + (n % 9) * 0.3 END,\n       CASE WHEN n % 100 = 0 THEN 190000 WHEN n % 3 = 0 THEN 200000 WHEN n % 3 = 1 THEN 1 ELSE 1 END\nFROM s",
     "status": "ok",
     "columns": [],
     "affected_rows": 3000,
     "info": "Records: 3000  Duplicates: 0  Warnings: 0",
     "rows": []
    },
    {
     "sql": "SELECT digest, COUNT(*) AS calls,\n       ROUND(SUM(duration_ms) / 1000, 2) AS total_s,\n       ROUND(100 * SUM(duration_ms) / SUM(SUM(duration_ms)) OVER (), 1) AS pct_of_total,\n       ROUND(AVG(duration_ms), 2) AS avg_ms,\n       MAX(duration_ms) AS max_ms,\n       ROUND(AVG(rows_examined)) AS rows_examined_per_call\nFROM query_log GROUP BY digest ORDER BY total_s DESC",
     "status": "ok",
     "columns": [
      "digest",
      "calls",
      "total_s",
      "pct_of_total",
      "avg_ms",
      "max_ms",
      "rows_examined_per_call"
     ],
